billing_email = "billing@mindclade.com"

wif_pool_project_number = "123456789012"
artifact_registry_host  = "us-central1-docker.pkg.dev"

environment_project_ids = {
  development = "mc-development-platform"
  staging     = "mc-staging-platform"
  production  = "mc-production-platform"
}

# Generated by scripts/export-ci-variables.sh from catalog and bootstrap outputs.
ci_variables = {
  github-config = {
    ORGANIZATION = "Mindclade"
  }
}

# Temporary reviewed overrides only. The resting state is in catalog/rulesets.yaml.
ruleset_enforcement_overrides = {}

# GitHub App slug to the exact repositories its installation may access.
# Omit Apps whose installation is intentionally organization-wide and governed elsewhere.
app_scopes = {
  # "mindclade-governance" = ["github-config"]
}
