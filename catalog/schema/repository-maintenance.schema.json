{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.dev/github/catalog/repository-maintenance/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "organization", "repositories"],
  "properties": {
    "schema_version": {"const": 1},
    "organization": {"const": "mindclade"},
    "repositories": {
      "type": "object",
      "minProperties": 7,
      "maxProperties": 7,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch_retention_days", "tag_retention_days", "protected_branches", "protected_branch_prefixes", "allowed_tag_patterns"],
        "properties": {
          "branch_retention_days": {"type": "integer", "minimum": 7, "maximum": 365},
          "tag_retention_days": {"type": "integer", "minimum": 7, "maximum": 365},
          "protected_branches": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}},
          "protected_branch_prefixes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}},
          "allowed_tag_patterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
        }
      }
    }
  }
}
