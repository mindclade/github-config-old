{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "workflows"],
  "properties": {
    "schema_version": {"const": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "release"],
      "properties": {
        "repository": {"const": ".github"},
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "status", "source_commit", "publication_gate"],
          "properties": {
            "version": {"const": "v5.0.0"},
            "status": {"enum": ["candidate", "published"]},
            "source_commit": {
              "oneOf": [
                {"type": "null"},
                {"type": "string", "pattern": "^[a-f0-9]{40}$"}
              ]
            },
            "publication_gate": {"const": "v5_release_published"}
          }
        }
      }
    },
    "workflows": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["implementation", "required_permissions", "consumers"],
        "properties": {
          "implementation": {
            "type": "string",
            "pattern": "^\\.github/workflows/[a-z0-9-]+\\.yml$"
          },
          "required_permissions": {"$ref": "#/$defs/permissions"},
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/consumer"}
          }
        }
      }
    }
  },
  "$defs": {
    "permissions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"enum": ["read", "write"]}
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "caller",
        "current_reference",
        "desired_reference",
        "state",
        "activation_gates",
        "permissions"
      ],
      "properties": {
        "repository": {"enum": [".github-private", "github-config"]},
        "caller": {
          "type": "string",
          "pattern": "^\\.github/workflows/[a-z0-9-]+\\.yml$"
        },
        "current_reference": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^(v[0-9]+\\.[0-9]+\\.[0-9]+|[a-f0-9]{40})$"}
          ]
        },
        "desired_reference": {"const": "v5.0.0"},
        "state": {"enum": ["blocked", "candidate", "released"]},
        "activation_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "permissions": {"$ref": "#/$defs/permissions"}
      }
    }
  }
}
