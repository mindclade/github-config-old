{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version", "organization", "observed_at", "qualification",
    "evidence_scope", "known_existing", "unresolved_discovery"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "organization": {"const": "mindclade"},
    "observed_at": {"type": "string", "format": "date"},
    "qualification": {"enum": ["blocked", "qualified"]},
    "evidence_scope": {"type": "string", "minLength": 1},
    "known_existing": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "name", "terraform_address", "import_id"],
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "terraform_address": {"type": "string", "minLength": 1},
          "import_id": {"type": "string", "minLength": 1},
          "state_id": {"type": "string", "minLength": 1},
          "connected_id": {"type": "string", "pattern": "^[0-9]+$"}
        }
      }
    },
    "unresolved_discovery": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource_class", "reason"],
        "additionalProperties": false,
        "properties": {
          "resource_class": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
